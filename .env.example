# =====================================================================
#  CS2 Intelligence — environment variables. Copy to .env and fill in.
#  NEVER commit .env to a repository.
# =====================================================================

# ---------- Bot / internal Eggdrop ⇄ backend API ----------
BOT_NAME=CS2Intel
BOT_TIMEZONE=Europe/Madrid
# Shared Eggdrop ⇄ backend token. Generate one:  python -c "import secrets;print(secrets.token_urlsafe(32))"
BOT_API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8787
API_ALLOWED_IPS=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8
# Public SVG charts (needs a reverse proxy in front of the API)
PUBLIC_URL=
PUBLIC_CHARTS=false
LOG_LEVEL=INFO

# ---------- IRC (used by settings.yaml and by the Eggdrop container) ----------
# Logical network name (key in settings.yaml → networks) and main channel
IRC_NETWORK=minet
IRC_MAIN_CHANNEL="#cs2"
# Eggdrop connection
IRC_NETWORK_NAME=Libera.Chat
IRC_NET_TYPE=Libera
IRC_SERVER=irc.libera.chat
IRC_PORT=+6697
IRC_SERVER_PASS=
IRC_NICK=CS2Intel
IRC_ALTNICK=CS2Intel_
IRC_REALNAME="CS2 Intelligence Bot"
IRC_CHANNELS="#cs2"
IRC_SASL_USER=
IRC_SASL_PASS=
# Bot owner (your IRC nick) and contact
EGG_OWNER=your_nick
EGG_ADMIN="your_nick <you@example.org>"
EGG_ADMIN_FLAGS="n|n"
EGG_LISTEN_PORT=

# ---------- Authorised outbound network ----------
# Public IP that ALL requests leave from (when the server has several IPs)
OUTBOUND_IP=
# Optional authorised proxy: http://user:password@host:port
OUTBOUND_PROXY=
HTTP_USER_AGENT="CS2IntelligenceBot/1.0 (+contact admin@example.org)"

# ---------- Database / cache ----------
# SQLite at data/cs2intel.db by default. PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://cs2:password@postgres:5432/cs2intel   (and WITH_POSTGRES=true)
DATABASE_URL=
WITH_POSTGRES=false
# Optional Redis:  REDIS_URL=redis://redis:6379/0  (and WITH_REDIS=true + --profile redis)
REDIS_URL=
WITH_REDIS=false

# ---------- Market ----------
MARKET_CURRENCY=EUR
# CSFloat: https://csfloat.com → Profile → Developers → create API key
CSFLOAT_ENABLED=false
CSFLOAT_API_KEY=
# Buff163: authorised access ONLY; session cookie of your own account (session=...)
BUFF_ENABLED=false
BUFF_COOKIE=
# Pricempire (paid plan): https://pricempire.com/api
PRICEMPIRE_ENABLED=false
PRICEMPIRE_API_KEY=

# ---------- Esports / LIVE ----------
# HLTV: only if HLTV has authorised the server IP. If you were given a header: "Header-Name: value"
HLTV_ENABLED=false
HLTV_AUTH_HEADER=
HLTV_COOKIE=
HLTV_USER_AGENT=
# PandaScore: https://app.pandascore.co → token (free plan: schedule/results; round-by-round LIVE needs a paid plan)
PANDASCORE_ENABLED=false
PANDASCORE_TOKEN=
# FACEIT Data API: https://developers.faceit.com → App → API key (server side). Championship IDs go in sources.yaml
FACEIT_ENABLED=false
FACEIT_API_KEY=

# ---------- News: summaries / translation ----------
# none | anthropic | libretranslate
NEWS_SUMMARIZER=none
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Self-hosted LibreTranslate (docker compose --profile translate): http://libretranslate:5000
LIBRETRANSLATE_ENABLED=false
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
